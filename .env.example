# ==============================================================================
# Образец файла переменных окружения (YYBackend Master Environment Config)
# ==============================================================================
# Актуальный мастер-шаблон находится в configs/.env.example
# Для инициализации локального окружения выполните:
#   cp configs/.env.example .env

# -----------------
# Основные настройки сервера
# -----------------
PORT=8080
BILLING_PORT=8081
# Порт веб-клиента YYWeb (основной: 3002, резервный: 3003)
YYWEB_PORT=3002
ENV=development

# -----------------
# Настройки Баз Данных (PostgreSQL)
# -----------------
# URL для подключения к базе данных кластера A (auth, users, notifications, backoffice, helpdesk, fraud)
DB_A_URL=postgres://postgres:password@postgres_a:5432/yolyolakay_users?sslmode=disable
# URL для подключения к базе данных кластера B (rides, billing, analytics, parcels, telematics)
DB_B_URL=postgres://postgres:password@postgres_b:5432/yolyolakay_rides?sslmode=disable
# Дополнительный URL базы данных биллинга
DB_C_URL=postgresql://postgres:password@postgres_b:5432/yolyolakay_billing?sslmode=disable

# -----------------
# Кэширование и Брокеры Сообщений
# -----------------
REDIS_ADDR=redis:6379
REDIS_PASS=
RABBITMQ_URL=amqp://yolyolakay:secret@rabbitmq:5672/

# -----------------
# Безопасность, Ключи и CORS
# -----------------
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8086,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,https://yolyolakay.com,https://api.yolyolakay.com,https://app.yolyolakay.com
PUBLIC_KEY_PATH=./configs/secrets/public.pem
FCM_CREDENTIALS_FILE=configs/secrets/serviceAccountKey.json
INTERNAL_API_SECRET=super-internal-secret-for-microservices
PARCEL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
WEBHOOK_ALLOWED_IPS=217.29.119.128/27,5.133.120.40/29,84.54.83.222,195.158.1.181,94.141.86.162

# -----------------
# Внутреннее gRPC Взаимодействие
# -----------------
BILLING_GRPC_URL=localhost:50051
USER_GRPC_URL=localhost:50052

# -----------------
# S3 Хранилище (MinIO / AWS S3)
# -----------------
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=yolyolakay-media
S3_BUCKET=s3://yolyolakay-backups/
AWS_DEFAULT_REGION=us-east-1
BACKUP_ENCRYPT_PASSWORD=my_secure_backup_password

# -----------------
# HTTP URLs Микросервисов (для API Gateway)
# -----------------
USER_SERVICE_URL=http://user_service:8081
AUTH_SERVICE_URL=http://auth_service:8082
RIDE_SERVICE_URL=http://ride_service:8083
BILLING_SERVICE_URL=http://billing_service:8084
PARCEL_SERVICE_URL=http://parcel_service:8085
NOTIFICATION_SERVICE_URL=http://notification_service:8086
TELEMATICS_SERVICE_URL=http://telematics_service:8087
ROUTING_SERVICE_URL=http://routing_service:8088
FRAUD_SERVICE_URL=http://antifraud_service:8089
HELPDESK_SERVICE_URL=http://helpdesk_service:8090
ANALYTICS_SERVICE_URL=http://analytics_service:8091
BACKOFFICE_SERVICE_URL=http://backoffice_service:8092
MEDIA_SERVICE_URL=http://media_service:8093
RATING_SERVICE_URL=http://rating_service:8094

# -----------------
# Swagger (Документация API)
# -----------------
SWAGGER_USER=admin
SWAGGER_PASSWORD=secret

# -----------------
# Наблюдаемость (Observability)
# -----------------
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
SENTRY_DSN=
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------
# Инфраструктурные учетные данные (Docker Compose)
# -----------------
POSTGRES_PASSWORD=your_secure_postgres_password
RABBITMQ_USER=yolyolakay
RABBITMQ_PASS=your_secure_rabbitmq_password
GRAFANA_PASSWORD=your_secure_grafana_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password
